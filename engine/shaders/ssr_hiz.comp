#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#include "bindless.glsl"

// Closest-depth pyramid for screen-space reflections: level 0 = the depth target (full
// resolution), then the max (reverse-Z: nearest) of 2 x 2 texels; odd sizes round up, the last
// row / column is clamped (every covered texel counts).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Src { float d[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Dst { float d[]; };

layout(push_constant) uniform SsrHiZPush {
    Src   src;
    Dst   dst;
    uvec2 srcSize;
    uvec2 dstSize;
    uint  depthSlot; // level 0: copy of the depth texture
    uint  fromDepth;
} pc;

float Load(uvec2 p)
{
    return pc.src.d[p.y * pc.srcSize.x + p.x];
}

void main()
{
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, pc.dstSize)))
        return;
    if (pc.fromDepth != 0u) {
        pc.dst.d[p.y * pc.dstSize.x + p.x] =
            texelFetch(sampler2D(uTextures[nonuniformEXT(pc.depthSlot)], uSamplers[SAMPLER_NEAREST_CLAMP]), ivec2(p), 0).r;
        return;
    }
    const uvec2 a = min(p * 2u, pc.srcSize - 1u);
    const uvec2 b = min(p * 2u + 1u, pc.srcSize - 1u);
    pc.dst.d[p.y * pc.dstSize.x + p.x] = max(max(Load(a), Load(uvec2(b.x, a.y))), max(Load(uvec2(a.x, b.y)), Load(b)));
}
